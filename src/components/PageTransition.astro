---
// Full-screen veil that cross-fades between internal navigations.
// It gives instant feedback on tap (no more "nothing happened"), masks the
// browser's swap-in of the destination page, and shows a small loader while
// the next page loads. Skipped entirely when reduced motion is requested.
---

<div id="page-transition-veil" class="page-transition-veil" aria-hidden="true"></div>

<script is:inline>
  // Runs before the browser's first paint of this document. If this page was
  // arrived at via the veil, start opaque so content is never flash-exposed.
  (() => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    try {
      if (sessionStorage.getItem("skq:transition") === "1") {
        document.documentElement.classList.add("vt-enter");
        sessionStorage.removeItem("skq:transition");
      }
    } catch {
      // Storage can be unavailable (private mode); navigation still works.
    }
  })();
</script>

<script>
  const veil = document.getElementById(
    "page-transition-veil"
  ) as HTMLElement | null;
  const root = document.documentElement;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const enabled = !reduceMotion.matches && !!veil;

  // Skip anything the browser opens as a document that isn't a page of this site.
  const notHtml = /\.(?:xml|pdf|zip|png|jpe?g|webp|gif|svg|ico|css|js|mjs|json|txt|woff2?|mp[34]|webm|mov)$/i;

  document.addEventListener(
    "click",
    (event) => {
      if (!enabled) return;
      // Plain left-click only; let new-tab/modified/middle clicks behave normally.
      if (event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (event.defaultPrevented) return;

      const anchor = (event.target as Element | null)?.closest?.(
        "a[href]"
      ) as HTMLAnchorElement | null;
      if (!anchor) return;
      if (anchor.hasAttribute("download")) return;
      if (anchor.target && anchor.target !== "_self") return;

      let url: URL;
      try {
        url = new URL(anchor.href, document.baseURI);
      } catch {
        return;
      }
      if (url.origin !== window.location.origin) return;
      if (notHtml.test(url.pathname)) return;
      const here = new URL(window.location.href);
      if (url.pathname === here.pathname && url.search === here.search) return;
      if (url.pathname === here.pathname && url.hash) return;

      const FADE_MS = 200;
      event.preventDefault();
      root.classList.add("vt-leave");
      window.setTimeout(() => {
        root.classList.remove("vt-leave");
        root.classList.add("vt-wait");
        try {
          sessionStorage.setItem("skq:transition", "1");
        } catch {
          // Ignore storage failures and navigate regardless.
        }
        window.location.assign(url.href);
      }, FADE_MS);
    },
    false
  );

  // The inline script marks vt-enter on arrival; fade it out once painted.
  const clearEnter = () => root.classList.remove("vt-enter");
  if (root.classList.contains("vt-enter")) {
    if (!reduceMotion.matches) {
      // Double rAF: wait for the destination to produce its first paint.
      requestAnimationFrame(() => requestAnimationFrame(clearEnter));
    } else {
      clearEnter();
    }
  }
</script>

<style is:global>
  .page-transition-veil {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--background, #121212);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .page-transition-veil::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border: 3px solid var(--border, rgba(127, 127, 127, 0.3));
    border-top-color: var(--foreground, rgba(127, 127, 127, 0.8));
    border-radius: 999px;
    opacity: 0;
    animation: page-transition-spin 700ms linear infinite;
  }

  html.vt-leave .page-transition-veil,
  html.vt-wait .page-transition-veil,
  html.vt-enter .page-transition-veil {
    opacity: 1;
    pointer-events: auto;
  }

  html.vt-wait .page-transition-veil::after {
    opacity: 1;
  }

  @keyframes page-transition-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-transition-veil {
      transition: none;
    }
  }
</style>
