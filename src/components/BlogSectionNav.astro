---
interface Props {
  active: "blogs" | "category" | "talks";
}

const { active } = Astro.props;

const links = [
  { id: "blogs", label: "Blog", href: "/blog" },
  { id: "category", label: "Category", href: "/blog/category" },
  { id: "talks", label: "Talks", href: "/talks" },
];
---

<nav aria-label="内容分区" class="blog-section-nav">
  <ul class="blog-section-tabs">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="blog-section-link"
            aria-current={active === link.id ? "page" : undefined}
          >
            {link.label}
            {active === link.id && (
              <span class="blog-section-indicator" aria-hidden="true" />
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .blog-section-nav {
    margin-bottom: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .blog-section-tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-section-link {
    position: relative;
    display: inline-flex;
    min-height: 4.25rem;
    align-items: center;
    color: var(--foreground);
    font-family:
      "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino,
      Georgia, serif;
    font-size: clamp(1.65rem, 3.5vw, 2.15rem);
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    opacity: 0.52;
    transition: opacity 180ms ease-out;
  }

  .blog-section-link:hover {
    opacity: 0.8;
  }

  .blog-section-link[aria-current="page"] {
    opacity: 1;
  }

  .blog-section-indicator {
    transform-origin: left center;
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--foreground);
  }

  @media (max-width: 479px) {
    .blog-section-tabs {
      gap: 1.25rem;
    }

    .blog-section-link {
      min-height: 3.75rem;
      font-size: 1.5rem;
    }
  }
</style>

<script>
  // Share tab snapshots only when both pages contain this navigation.
  document.addEventListener("astro:before-preparation", (event) => {
    const load = event.loader;
    event.loader = async () => {
      await load();
      if (event.signal.aborted || event.defaultPrevented) return;
      const current = document.querySelector<HTMLElement>(".blog-section-nav");
      const next = event.newDocument.querySelector<HTMLElement>(".blog-section-nav");
      for (const nav of [current, next]) {
        if (!nav) continue;
        nav.style.setProperty("view-transition-name", current && next ? "blog-tabs" : "none");
        const indicator = nav.querySelector<HTMLElement>(".blog-section-indicator");
        if (indicator) indicator.style.setProperty("view-transition-name", current && next ? "blog-tab-indicator" : "none");
      }
    };
  });

  let previousIndicator: DOMRect | undefined;
  document.addEventListener("astro:before-swap", (event) => {
    previousIndicator = undefined;
    if ("startViewTransition" in document && typeof document.startViewTransition === "function") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (event.newDocument.querySelector(".blog-section-nav")) {
      previousIndicator = document.querySelector(".blog-section-indicator")?.getBoundingClientRect();
    }
  });
  document.addEventListener("astro:after-swap", () => {
    if (!previousIndicator) return;
    const indicator = document.querySelector<HTMLElement>(".blog-section-indicator");
    const next = indicator?.getBoundingClientRect();
    if (indicator && next?.width) {
      indicator.animate([
        { transform: `translateX(${previousIndicator.x - next.x}px) scaleX(${previousIndicator.width / next.width})` },
        { transform: "none" },
      ], { duration: 260, easing: "cubic-bezier(0.22, 1, 0.36, 1)" });
    }
    previousIndicator = undefined;
  });
</script>

<style is:global>
  ::view-transition-group(blog-tabs) {
    animation: none;
  }
  ::view-transition-old(blog-tabs),
  ::view-transition-new(blog-tabs),
  ::view-transition-old(blog-tab-indicator),
  ::view-transition-new(blog-tab-indicator) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-old(blog-tabs),
  ::view-transition-old(blog-tab-indicator) {
    opacity: 0;
  }
  ::view-transition-group(blog-tab-indicator) {
    animation-duration: 260ms;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(blog-tab-indicator) {
      animation: none;
    }
  }
</style>
