---
import { Icon } from "astro-icon/components";

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const items = Astro.props.headings
  .filter(({ depth }) => depth === 2 || depth === 3)
  .map((heading) => {
    const numbered = heading.text.match(/^(\d+)[.、．]\s*(.+)$/);
    return { ...heading, number: numbered?.[1], label: numbered?.[2] ?? heading.text };
  });
---

<aside class="article-sidebar">
  <a class="toc-back toc-desktop-back" href="/blog" aria-label="返回博客列表" title="返回博客列表">
    <Icon name="mdi:arrow-left" width={16} height={16} />博客
  </a>
  <details class="toc-desktop" open>
    <summary class="toc-desktop-toggle" aria-label="展开或收起文章目录" title="展开或收起文章目录">
      <Icon name="mdi:format-list-bulleted" width={20} height={20} aria-hidden="true" />
    </summary>
    <nav aria-label="文章目录" class="toc-nav">
      <ol>
        {items.map((item) => (
          <li><a href={`#${item.slug}`} data-heading={item.slug} class:list={["toc-link", { "toc-link--nested": item.depth === 3 }]}>
            {item.number && <span class="toc-number">{item.number}.</span>}
            <span class="toc-text">{item.label}</span>
          </a></li>
        ))}
      </ol>
      {items.length === 0 && <p class="toc-empty">本文没有分节。</p>}
    </nav>
  </details>
</aside>

<button id="article-toc-toggle" class="toc-control toc-toggle" type="button" aria-label="打开文章目录" title="打开文章目录" aria-haspopup="dialog" aria-controls="article-toc-sheet" aria-expanded="false">
  <Icon name="mdi:format-list-bulleted" width={23} height={23} aria-hidden="true" />
</button>

<dialog id="article-toc-sheet" class="toc-sheet" aria-labelledby="toc-sheet-title">
  <div class="toc-handle" aria-hidden="true"></div>
  <div class="toc-sheet-heading">
    <h2 id="toc-sheet-title">本文目录</h2>
    <button type="button" class="toc-close" aria-label="关闭文章目录"><Icon name="mdi:close" width={22} height={22} /></button>
  </div>
  <nav aria-label="文章目录" class="toc-nav">
    <ol>
      {items.map((item) => (
        <li><a href={`#${item.slug}`} data-heading={item.slug} class:list={["toc-link", { "toc-link--nested": item.depth === 3 }]}>
          {item.number && <span class="toc-number">{item.number}.</span>}
          <span class="toc-text">{item.label}</span>
        </a></li>
      ))}
    </ol>
    {items.length === 0 && <p class="toc-empty">本文没有分节。</p>}
    <a class="toc-back" href="/blog"><Icon name="mdi:arrow-left" width={16} height={16} />返回博客</a>
  </nav>
</dialog>

<script>
  document.addEventListener("astro:page-load", () => {
    const sheet = document.getElementById("article-toc-sheet") as HTMLDialogElement | null;
    const toggle = document.getElementById("article-toc-toggle") as HTMLButtonElement | null;
    if (!sheet || !toggle) return;
    const controller = new AbortController();
    const { signal } = controller;
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-link"));
    const sections = Array.from(document.querySelectorAll<HTMLAnchorElement>(".article-sidebar .toc-link"))
      .map((link) => document.getElementById(link.dataset.heading!))
      .filter((section): section is HTMLElement => section !== null);
    let frame = 0;
    let previousOverflow = "";

    const updateCurrent = () => {
      frame = 0;
      let current: HTMLElement | undefined;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= 140) current = section;
      }
      if (window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        current = sections.at(-1);
      }
      links.forEach((link) => {
        if (link.dataset.heading === current?.id) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(updateCurrent);
    };
    window.addEventListener("scroll", onScroll, { passive: true, signal });
    window.addEventListener("resize", onScroll, { signal });
    updateCurrent();

    const closeSheet = () => {
      if (!sheet.open) return;
      sheet.close();
      document.documentElement.style.overflow = previousOverflow;
      toggle.setAttribute("aria-expanded", "false");
    };
    toggle.addEventListener("click", () => {
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = "hidden";
      sheet.showModal();
      toggle.setAttribute("aria-expanded", "true");
      sheet.querySelector<HTMLElement>('[aria-current="location"]')?.focus();
    });
    sheet.querySelector(".toc-close")!.addEventListener("click", closeSheet);
    sheet.addEventListener("cancel", (event) => { event.preventDefault(); closeSheet(); });
    sheet.addEventListener("click", (event) => {
      const bounds = sheet.getBoundingClientRect();
      if (event.target === sheet && (event.clientY < bounds.top || event.clientY > bounds.bottom || event.clientX < bounds.left || event.clientX > bounds.right)) closeSheet();
      if ((event.target as Element).closest('a[href="/blog"]')) closeSheet();
    });
    links.forEach((link) => link.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const target = document.getElementById(link.dataset.heading!);
      if (!target) return;
      closeSheet();
      // Keep normal anchor navigation; move keyboard focus without animating the article.
      target.setAttribute("tabindex", "-1");
      target.focus({ preventScroll: true });
    }));
    window.matchMedia("(min-width: 1200px)").addEventListener("change", (event) => {
      if (event.matches) closeSheet();
    }, { signal });
    document.addEventListener("astro:before-swap", () => {
      closeSheet();
      controller.abort();
      cancelAnimationFrame(frame);
    }, { once: true });
  });
</script>

<style>
  .article-sidebar {
    display: none;
  }
  .toc-nav {
    font-size: 0.875rem;
  }
  .toc-sheet-heading h2 {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .toc-nav ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-left: 2px solid transparent;
    color: var(--article-body);
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .toc-link--nested {
    padding-left: 1.75rem;
    font-size: 0.8rem;
  }
  .toc-number {
    flex: none;
    min-width: 1.15em;
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
  }
  .toc-text {
    min-width: 0;
    text-wrap: pretty;
  }
  .toc-empty {
    margin: 1rem 0;
    color: var(--article-body);
    font-size: 0.8rem;
  }
  .toc-link:hover {
    color: var(--foreground);
    background: var(--surface-subtle);
  }
  .toc-link[aria-current="location"] {
    border-left-color: var(--foreground);
    color: var(--foreground);
    background: var(--surface-subtle);
  }
  .toc-back {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--article-body);
    text-decoration: none;
  }
  .toc-back:hover {
    color: var(--foreground);
  }
  .toc-control {
    display: inline-flex;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    color: var(--foreground);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.16);
    opacity: 0.78;
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition:
      opacity 180ms ease-out,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 180ms ease-out;
  }
  .toc-control:hover {
    background: var(--surface-hover);
    opacity: 1;
    transform: translateY(-2px);
  }
  .toc-control:active {
    transform: translateY(0) scale(0.94);
  }
  .toc-toggle {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 35;
  }
  .toc-desktop-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin: 0 0 0.75rem auto;
    border-radius: 0.5rem;
    list-style: none;
    color: var(--article-body);
    cursor: pointer;
  }
  .toc-desktop-toggle:hover {
    background: var(--surface-subtle);
    color: var(--foreground);
  }
  .toc-desktop-back {
    position: absolute;
    top: 0;
    left: 0;
    min-height: 36px;
    font-size: 0.8rem;
  }
  .toc-desktop-toggle::-webkit-details-marker {
    display: none;
  }
  .toc-sheet {
    position: fixed;
    inset: auto 0 0;
    margin: 0 auto;
    width: 100%;
    max-width: 40rem;
    max-height: 75dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.75rem 1.25rem max(1rem, env(safe-area-inset-bottom));
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 1.5rem 1.5rem 0 0;
    background: var(--background);
    color: var(--foreground);
  }
  .toc-sheet::backdrop {
    background: rgb(0 0 0 / 28%);
  }
  .toc-handle {
    width: 2rem;
    height: 3px;
    margin: 0 auto 0.5rem;
    border-radius: 999px;
    background: var(--border);
  }
  .toc-sheet-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .toc-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: inherit;
  }
  .toc-sheet .toc-back {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
  }
  @media (max-width: 639px) {
    .toc-toggle {
      left: max(0.75rem, env(safe-area-inset-left));
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      width: 44px;
      height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc-control {
      transition: none;
    }
  }
  @media (min-width: 1200px) {
    .article-sidebar {
      display: block;
      position: sticky;
      top: 2rem;
      max-height: calc(100dvh - 4rem);
      overflow-y: auto;
      scrollbar-width: thin;
    }
    .article-sidebar .toc-nav ol {
      border-left: 1px solid var(--border);
    }
    .article-sidebar .toc-link {
      margin-left: -1px;
      padding: 0.5rem 0.75rem;
      font-size: 0.8125rem;
      line-height: 1.6;
    }
    .article-sidebar .toc-link--nested {
      padding-left: 1.5rem;
      font-size: 0.75rem;
    }
    .article-sidebar .toc-link[aria-current="location"] {
      background: transparent;
      font-weight: 500;
    }
    .toc-toggle {
      display: none;
    }
  }
</style>
