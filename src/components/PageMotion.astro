<script>
  const revealSelector = [
    ".project-section",
    ".friends-grid > li",
    ".blog-post-item",
    ".photo-gallery__item",
    ".divide-y > *",
  ].join(",");

  let isFirstPage = true;
  const initializePageMotion = () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.documentElement.classList.toggle("motion-enabled", !reduceMotion);
    if (isFirstPage && !reduceMotion && !document.querySelector(".article-prose")) {
      document.getElementById("main-content")?.animate(
        [{ opacity: 0.65, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }],
        { duration: 260, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
      );
    }
    isFirstPage = false;
    if (reduceMotion) return;

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("motion-reveal--visible");
          revealObserver.unobserve(entry.target);
        });
      },
      {
        rootMargin: "0px 0px -8% 0px",
        threshold: 0.06,
      },
    );

    // Read layout before adding classes to avoid repeated layout passes.
    const elements = Array.from(document.querySelectorAll<HTMLElement>(revealSelector))
      .filter((element) => !element.closest("dialog") && !element.hidden)
      .map((element) => ({ element, bounds: element.getBoundingClientRect() }));

    elements.forEach(({ element, bounds }, index) => {
      const isInitiallyVisible =
        bounds.top < window.innerHeight * 0.92 && bounds.bottom > 0;

      if (isInitiallyVisible) return;

      element.classList.add("motion-reveal");
      element.style.setProperty(
        "--motion-reveal-delay",
        `${(index % 4) * 35}ms`,
      );
      revealObserver.observe(element);
    });
    document.addEventListener("astro:before-swap", () => revealObserver.disconnect(), { once: true });
  };

  document.addEventListener("astro:page-load", initializePageMotion);
</script>

<style is:global>
  html.motion-enabled .motion-reveal {
    opacity: 0;
    transform: translate3d(0, 1.125rem, 0);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--motion-reveal-delay, 0ms);
  }

  html.motion-enabled .motion-reveal.motion-reveal--visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html.motion-enabled .motion-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
