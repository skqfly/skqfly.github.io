---
import { Icon } from "astro-icon/components";
interface Props {
  text: string;
  href: string;
  external?: boolean;
}

const { text, href, external } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noreferrer" : undefined}
  class="flex min-h-11 items-center gap-2 rounded-md px-1 opacity-60 transition-opacity group-hover:opacity-30 hover:!opacity-100"
>
  <div class="rotate-45">
    <Icon name="mdi:arrow-up" />
  </div>
  <span>{text}</span>
</a>
